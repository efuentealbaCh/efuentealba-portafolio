---

<section id="habilidades" class="section section-alt">
  <div class="container">
    <p class="section-label fade-in">{lang === "es" ? "Tecnologías" : "Technologies"}</p>
    <h2 class="section-title fade-in delay-100">{lang === "es" ? "Habilidades Técnicas" : "Technical Skills"}</h2>
    <div class="section-divider fade-in delay-200"></div>

    <div class="skills-grid">
      {skillGroups.map((group, gi) => (
        <div class={`skill-card card fade-in delay-${(gi + 2) * 100}${group.isAI ? " skill-card-ai" : ""}`}>
          <div class="skill-card-header">
            <span class="skill-icon">{group.icon}</span>
            <h4 class="skill-category">{group.category}</h4>
            {group.isAI && (
              <span class="ai-badge">{lang === "es" ? "Integrado al flujo" : "Integrated in workflow"}</span>
            )}
          </div>
          {group.isAI && (
            <p class="ai-card-desc">
              {lang === "es"
                ? "Uso activo de herramientas de IA generativa dentro del ciclo de desarrollo: desde la arquitectura y el vibe coding hasta las pruebas automatizadas y la documentación técnica."
                : "Active use of generative AI tools within the development lifecycle: from architecture and vibe coding to automated testing and technical documentation."}
            </p>
          )}
          <div class="skill-tags">
            {group.skills.map((s) => (
              <div class={`skill-chip-wrapper${s.customIcon ? " ai-chip-wrapper" : ""}`}>
                <span class={`tech-chip${s.customIcon ? ` chip-ai chip-${s.customIcon}` : ""}`}>
                  {s.customIcon && (
                    <span class="tech-icon custom-icon" set:html={customIcons[s.customIcon]} />
                  )}
                  {!s.customIcon && s.devicon && (
                    <img
                      src={`https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${s.devicon.split("-")[0]}/${s.devicon}.svg`}
                      alt={s.name}
                      class="tech-icon"
                    />
                  )}
                  {s.name}
                </span>
                {s.label && <span class="chip-label">{s.label}</span>}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px;
  }

  .skill-card { padding: 28px 24px; }

  .skill-card-ai {
    grid-column: 1 / -1;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(196, 104, 16, 0.25);
  }

  .skill-card-ai::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #c46810, #4285f4, #7c4dff);
    border-radius: 2px 2px 0 0;
  }

  .skill-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .skill-icon { font-size: 1.4rem; line-height: 1; }

  .skill-category {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .ai-badge {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(196, 104, 16, 0.12), rgba(66, 133, 244, 0.12));
    border: 1px solid rgba(196, 104, 16, 0.3);
    color: var(--color-accent);
    font-weight: 600;
    white-space: nowrap;
  }

  .ai-card-desc {
    font-size: 0.85rem;
    color: var(--color-muted);
    line-height: 1.75;
    margin-bottom: 20px;
    max-width: 760px;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: flex-start;
  }

  .skill-chip-wrapper {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .chip-label {
    font-size: 0.68rem;
    color: var(--color-muted);
    line-height: 1.4;
    padding-left: 4px;
    max-width: 220px;
  }

  .tech-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .chip-claude {
    background: linear-gradient(135deg, rgba(210, 105, 30, 0.12) 0%, rgba(205, 127, 50, 0.08) 100%);
    border-color: rgba(210, 105, 30, 0.35);
    color: #c46810;
  }

  .chip-claude .custom-icon svg { fill: #c46810; }

  .chip-gemini {
    background: linear-gradient(135deg, rgba(66, 133, 244, 0.12) 0%, rgba(138, 94, 240, 0.08) 100%);
    border-color: rgba(66, 133, 244, 0.35);
    color: #4285f4;
  }

  .chip-gemini .custom-icon svg { fill: #7c4dff; }

  .tech-icon { width: 16px; height: 16px; object-fit: contain; }

  .custom-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .custom-icon svg { width: 16px; height: 16px; }

  @media (max-width: 600px) {
    .skill-card-ai { grid-column: auto; }
    .ai-badge { margin-left: 0; width: fit-content; }
  }
</style>
