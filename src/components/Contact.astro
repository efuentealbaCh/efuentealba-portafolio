---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const socials = [
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/eliacer-fuentealba-5b3003229/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
  {
    name: 'GitHub',
    href: 'https://github.com/efuentealbaCh',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`,
  },
  {
    name: 'Email',
    href: 'mailto:efuentealba038@gmail.com',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
  },
  {
    name: 'WhatsApp',
    href: 'https://wa.me/56921653786',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
  },
];
---

<section id="contacto" class="section section-alt">
  <div class="container">
    <div class="contact-inner">
      <div class="contact-text fade-in">
        <p class="section-label">{lang === 'es' ? 'Contacto' : 'Contact'}</p>
        <h2 class="section-title" set:html={lang === 'es' ? '¿Tienes un proyecto<br />en mente?' : 'Have a project<br />in mind?'} />
        <div class="section-divider"></div>
        <p class="contact-desc">
          {lang === 'es' 
            ? 'Estoy disponible para proyectos de desarrollo Backend, APIs, microservicios y arquitecturas modernas. También abierto a colaboraciones y oportunidades remotas.'
            : 'I am available for Backend development projects, APIs, microservices, and modern architectures. Also open to collaborations and remote opportunities.'
          }
        </p>
        <a href="mailto:efuentealba038@gmail.com" class="contact-email fade-in delay-200">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          efuentealba038@gmail.com
        </a>
      </div>

      <div class="social-grid fade-in delay-300">
        {socials.map(s => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="social-card" aria-label={s.name}>
            <div class="social-icon" set:html={s.icon} />
            <span class="social-name">{s.name}</span>
            <svg class="social-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .contact-desc {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.8;
    margin-bottom: 32px;
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-accent);
    font-weight: 500;
    font-size: 1rem;
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-light);
    padding-bottom: 4px;
    transition: color 0.2s, border-color 0.2s;
  }

  .contact-email:hover {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  .social-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .social-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .social-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(107, 91, 71, 0.1);
    border-color: var(--color-accent-light);
  }

  .social-icon { color: var(--color-accent); flex-shrink: 0; }

  .social-name {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text);
    flex: 1;
  }

  .social-arrow {
    color: var(--color-muted);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity 0.2s, transform 0.2s;
  }

  .social-card:hover .social-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (max-width: 900px) {
    .contact-inner { grid-template-columns: 1fr; gap: 48px; }
  }
  @media (max-width: 520px) {
    .social-grid { grid-template-columns: 1fr; }
  }
</style>
