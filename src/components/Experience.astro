---

<section id="experiencia" class="section">
  <div class="container">
    <p class="section-label fade-in">{lang === 'es' ? 'Trayectoria' : 'Career'}</p>
    <h2 class="section-title fade-in delay-100">{lang === 'es' ? 'Experiencia Profesional' : 'Professional Experience'}</h2>
    <div class="section-divider fade-in delay-200"></div>

    <div class="timeline">
      {
        experiences.map((exp, i) => (
          <div
            class={`timeline-item fade-in delay-${Math.min((i + 2) * 100, 500)}`}
          >
            <div class="timeline-period">
              <span class="period-text">{exp.period}</span>
              <div class="timeline-dot" />
            </div>
            <div class="timeline-body card">
              <h3 class="exp-role">{exp.role}</h3>
              <div class="exp-meta">
                <span class="exp-company">{exp.company}</span>
                <span class="exp-sep">·</span>
                <span class="exp-location">{exp.location}</span>
              </div>
              <ul class="exp-list">
                {exp.description.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
              {exp.tags && (
                <div class="tag-list">
                  {exp.tags.map((t) => (
                    <span class="tech-chip">
                      {t.icon && (
                        <img
                          src={`https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${t.icon}/${t.icon}-original.svg`}
                          alt={t.name}
                          class="tech-icon"
                          onerror={`this.src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${t.icon}/${t.icon}-plain.svg'`}
                        />
                      )}
                      {t.name}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 160px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 40px;
    align-items: start;
    padding: 24px 0;
  }

  .timeline-period {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 16px;
    padding-top: 6px;
  }

  .period-text {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    text-align: right;
    line-height: 1.5;
  }

  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 3px var(--color-accent-light);
    flex-shrink: 0;
    margin-top: 4px;
    position: relative;
    right: -5px;
  }

  .timeline-body {
    padding: 22px 26px;
  }

  .exp-role {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 6px;
  }

  .exp-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .exp-company {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    font-weight: 500;
  }

  .exp-sep {
    color: var(--color-border);
  }

  .exp-location {
    font-size: 0.76rem;
    color: var(--color-muted);
  }

  .exp-list {
    padding-left: 18px;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .exp-list li {
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-bg);
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .tech-icon {
    width: 14px;
    height: 14px;
    object-fit: contain;
  }

  @media (max-width: 700px) {
    .timeline::before {
      display: none;
    }
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .timeline-period {
      justify-content: flex-start;
    }
    .timeline-dot {
      display: none;
    }
  }
</style>
