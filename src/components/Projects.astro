<style is:global>
  /* tech-chip must be global so it applies to elements created via JS in the modal */
  .modal-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .modal-chip img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const modal = document.getElementById("project-modal") as HTMLElement;
    const closeBtn = document.getElementById("proj-modal-close");
    const track = document.getElementById("proj-carousel-track") as HTMLElement;
    const dotsContainer = document.getElementById(
      "carousel-dots",
    ) as HTMLElement;
    const prevBtn = document.getElementById("carousel-prev");
    const nextBtn = document.getElementById("carousel-next");
    const modalTitle = document.getElementById("proj-modal-title");
    const modalBadge = document.getElementById("proj-modal-badge");
    const modalYear = document.getElementById("proj-modal-year");
    const modalDesc = document.getElementById("proj-modal-desc");
    const modalTags = document.getElementById("proj-modal-tags");
    const modalLink = document.getElementById(
      "proj-modal-link",
    ) as HTMLAnchorElement;

    if (!modal) return;

    let currentSlide = 0;
    let totalSlides = 0;

    function goTo(index: number) {
      currentSlide = (index + totalSlides) % totalSlides;
      track.style.transform = `translateX(-${currentSlide * 100}%)`;
      document.querySelectorAll(".carousel-dot").forEach((d, i) => {
        d.classList.toggle("active", i === currentSlide);
      });
    }

    prevBtn?.addEventListener("click", () => goTo(currentSlide - 1));
    nextBtn?.addEventListener("click", () => goTo(currentSlide + 1));

    // Open modal
    document.querySelectorAll(".project-card").forEach((card) => {
      const open = () => {
        const raw = card.getAttribute("data-project");
        if (!raw) return;
        const data = JSON.parse(raw);

        // Carousel
        track.innerHTML = "";
        dotsContainer.innerHTML = "";
        totalSlides = data.images.length;
        currentSlide = 0;

        data.images.forEach((src: string, i: number) => {
          const img = document.createElement("img");
          img.src = src;
          img.alt = `${data.title} screenshot ${i + 1}`;
          img.loading = "lazy";
          track.appendChild(img);

          const dot = document.createElement("button");
          dot.className = `carousel-dot${i === 0 ? " active" : ""}`;
          dot.setAttribute("aria-label", `Slide ${i + 1}`);
          dot.addEventListener("click", () => goTo(i));
          dotsContainer.appendChild(dot);
        });

        track.style.transform = "translateX(0)";

        // Show/hide nav
        const showNav = totalSlides > 1;
        if (prevBtn)
          (prevBtn as HTMLElement).style.display = showNav ? "flex" : "none";
        if (nextBtn)
          (nextBtn as HTMLElement).style.display = showNav ? "flex" : "none";
        dotsContainer.style.display = showNav ? "flex" : "none";

        // Content
        if (modalTitle) modalTitle.textContent = data.title;
        if (modalBadge) modalBadge.textContent = data.type;
        if (modalYear) modalYear.textContent = data.year;
        if (modalDesc) modalDesc.textContent = data.longDescription;

        // Link
        if (modalLink) {
          if (data.link) {
            modalLink.href = data.link;
            modalLink.classList.remove("hidden");
          } else {
            modalLink.classList.add("hidden");
          }
        }

        // Tags — same chip style as project cards
        if (modalTags) {
          modalTags.innerHTML = "";
          data.tags.forEach((tag: { name: string; icon?: string }) => {
            const chip = document.createElement("span");
            chip.className = "modal-chip";
            if (tag.icon) {
              const iconBase = tag.icon.split("-")[0];
              const img = document.createElement("img");
              img.src = `https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${iconBase}/${tag.icon}.svg`;
              img.alt = tag.name;
              img.crossOrigin = "anonymous";
              img.width = 16;
              img.height = 16;
              img.onerror = () => {
                img.style.display = "none";
              };
              chip.appendChild(img);
            }
            chip.appendChild(document.createTextNode(tag.name));
            modalTags.appendChild(chip);
          });
        }

        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      };

      card.addEventListener("click", open);
      card.addEventListener("keydown", (e) => {
        if (
          (e as KeyboardEvent).key === "Enter" ||
          (e as KeyboardEvent).key === " "
        ) {
          e.preventDefault();
          open();
        }
      });
    });

    // Close
    const closeModal = () => {
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      setTimeout(() => {
        track.innerHTML = "";
        dotsContainer.innerHTML = "";
      }, 350);
    };

    closeBtn?.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("is-open"))
        closeModal();
      if (e.key === "ArrowLeft" && modal.classList.contains("is-open"))
        goTo(currentSlide - 1);
      if (e.key === "ArrowRight" && modal.classList.contains("is-open"))
        goTo(currentSlide + 1);
    });
  });
</script>
