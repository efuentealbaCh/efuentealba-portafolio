const projects = projectsData[lang];

const typeColors: Record<string, string> = {
  Automatización: "#7C6B4E",
  Automation: "#7C6B4E",
  "Web App": "#5A7D6B",
  Dashboard: "#4E6B7C",
  Backend: "#7C5A6B",
  Frontend: "#6B7C4E",
};
---

<section id="proyectos" class="section section-alt">
  <div class="container">
    <p class="section-label fade-in">
      {lang === "es" ? "Portafolio" : "Portfolio"}
    </p>
    <h2 class="section-title fade-in delay-100">
      {lang === "es" ? "Proyectos Destacados" : "Featured Projects"}
    </h2>
    <div class="section-divider fade-in delay-200"></div>

    <div class="projects-grid">
      {
        projects.map((proj, i) => (
          <article
            class={`project-card card fade-in delay-${Math.min(((i % 3) + 2) * 100, 500)}`}
            data-project={JSON.stringify({
              title: proj.title,
              longDescription: proj.longDescription,
              type: proj.type,
              year: proj.year,
              tags: proj.tags,
              link: proj.link || null,
              images: proj.images,
            })}
            tabindex="0"
            role="button"
            aria-label={`${lang === "es" ? "Ver detalles de" : "View details for"} ${proj.title}`}
          >
            <div class="project-image">
              <div class="project-image-inner">
                <span
                  class="project-type-badge"
                  style={`background: ${typeColors[proj.type] || "#6B5B47"}22; color: ${typeColors[proj.type] || "#6B5B47"}`}
                >
                  {proj.type}
                </span>
              </div>
              <div class="project-hover-overlay">
                <span class="project-hover-cta">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <circle cx="11" cy="11" r="8" />
                      <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </>
                  </svg>
                  {lang === "es" ? "Ver detalle" : "View detail"}
                </span>
              </div>
            </div>
            <div class="project-body">
              <div class="project-meta">
                <span class="project-year">{proj.year}</span>
              </div>
              <h3 class="project-title">{proj.title}</h3>
              <p class="project-description">{proj.description}</p>
              <div class="tag-list">
                {proj.tags.map((t) => (
                  <span class="tech-chip">
                    {t.icon && (
                      <img
                        src={`https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${t.icon.split('-')[0]}/${t.icon}.svg`}
                        alt={t.name}
                        class="tech-icon"
                        crossorigin="anonymous"
                        onerror="this.style.display='none'"
                      />
                    )}
                    {t.name}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Project Detail Modal -->
<div
  id="project-modal"
  class="proj-modal-overlay"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
>
  <div class="proj-modal-content">
    <button
      id="proj-modal-close"
      class="proj-modal-close"
      aria-label={lang === "es" ? "Cerrar" : "Close"}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><line x1="18" y1="6" x2="6" y2="18"></line><line
          x1="6"
          y1="6"
          x2="18"
          y2="18"></line></svg
      >
    </button>

    <!-- Carousel -->
    <div class="proj-carousel" id="proj-carousel">
      <div class="proj-carousel-track" id="proj-carousel-track"></div>
      <button
        class="carousel-btn carousel-prev"
        id="carousel-prev"
        aria-label="Anterior"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="15 18 9 12 15 6"></polyline></svg
        >
      </button>
      <button
        class="carousel-btn carousel-next"
        id="carousel-next"
        aria-label="Siguiente"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="9 18 15 12 9 6"></polyline></svg
        >
      </button>
      <div class="carousel-dots" id="carousel-dots"></div>
    </div>

    <!-- Modal Body -->
    <div class="proj-modal-body">
      <div class="proj-modal-header">
        <div>
          <span class="proj-modal-badge" id="proj-modal-badge"></span>
          <h2 class="proj-modal-title" id="proj-modal-title"></h2>
          <span class="proj-modal-year" id="proj-modal-year"></span>
        </div>
        <a
          id="proj-modal-link"
          class="proj-modal-link-btn"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><line x1="7" y1="17" x2="17" y2="7"></line><polyline
              points="7 7 17 7 17 17"></polyline></svg
          >
          {lang === "es" ? "Ver proyecto" : "View project"}
        </a>
      </div>
      <p class="proj-modal-description" id="proj-modal-desc"></p>
      <div class="proj-modal-stack">
        <p class="proj-modal-stack-title">
          {lang === "es" ? "Stack Tecnológico" : "Tech Stack"}
        </p>
        <div class="proj-modal-tags" id="proj-modal-tags"></div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ---- GRID ---- */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  /* ---- CARD ---- */
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    cursor: pointer;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.15);
  }

  .project-image {
    aspect-ratio: 16/9;
    background: linear-gradient(
      135deg,
      var(--color-surface-alt) 0%,
      var(--color-border) 100%
    );
    position: relative;
    overflow: hidden;
  }

  .project-image::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgba(107, 91, 71, 0.04) 10px,
      rgba(107, 91, 71, 0.04) 11px
    );
  }

  .project-image-inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 12px;
    z-index: 1;
  }

  .project-hover-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 2;
  }

  .project-card:hover .project-hover-overlay {
    opacity: 1;
  }

  .project-hover-cta {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .project-type-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: 999px;
    font-weight: 500;
  }

  .project-body {
    padding: 22px 24px 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .project-year {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }

  .project-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    margin: 0;
  }

  .project-description {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.7;
    flex: 1;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .tech-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-bg);
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .tech-icon {
    width: 14px;
    height: 14px;
    object-fit: contain;
  }

  /* ---- MODAL ---- */
  .proj-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .proj-modal-overlay.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .proj-modal-content {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    width: 100%;
    max-width: 760px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    transform: translateY(24px) scale(0.97);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .proj-modal-overlay.is-open .proj-modal-content {
    transform: translateY(0) scale(1);
  }

  .proj-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 10;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text);
    transition: all 0.2s ease;
  }

  .proj-modal-close:hover {
    background: var(--color-bg);
    border-color: var(--color-accent);
  }

  /* ---- CAROUSEL ---- */
  .proj-carousel {
    position: relative;
    border-radius: 24px 24px 0 0;
    overflow: hidden;
    aspect-ratio: 16/8;
    background: var(--color-surface-alt);
  }

  .proj-carousel-track {
    display: flex;
    height: 100%;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .proj-carousel-track img {
    min-width: 100%;
    height: 100%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.45);
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #fff;
    transition: background 0.2s ease;
    z-index: 5;
  }

  .carousel-btn:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  .carousel-prev {
    left: 14px;
  }
  .carousel-next {
    right: 14px;
  }

  .carousel-dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    z-index: 5;
  }

  .carousel-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    transition:
      background 0.25s ease,
      transform 0.25s ease;
    cursor: pointer;
    border: none;
  }

  .carousel-dot.active {
    background: #fff;
    transform: scale(1.3);
  }

  /* ---- MODAL BODY ---- */
  .proj-modal-body {
    padding: 28px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .proj-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .proj-modal-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 6px;
    font-weight: 600;
  }

  .proj-modal-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
    margin: 0 0 4px;
  }

  .proj-modal-year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }

  .proj-modal-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    background: var(--color-accent);
    color: var(--color-bg);
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .proj-modal-link-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .proj-modal-link-btn.hidden {
    display: none;
  }

  .proj-modal-description {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.85;
    margin: 0;
  }

  .proj-modal-stack {
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
  }

  .proj-modal-stack-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .proj-modal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .proj-modal-tags .tech-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--color-surface-alt);
    border: 1.5px solid var(--color-accent-light);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.02em;
    transition: all 0.2s ease;
  }

  .proj-modal-tags .tech-chip:hover {
    background: var(--color-bg);
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px -4px rgba(0, 0, 0, 0.12);
  }

  .proj-modal-tags .tech-chip .tech-icon {
    width: 18px;
    height: 18px;
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .proj-modal-body {
      padding: 20px;
    }
    .proj-modal-title {
      font-size: 1.2rem;
    }
  }
</style>

<style is:global>
  /* tech-chip must be global so it applies to elements created via JS in the modal */
  .modal-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .modal-chip img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const modal = document.getElementById("project-modal") as HTMLElement;
    const closeBtn = document.getElementById("proj-modal-close");
    const track = document.getElementById("proj-carousel-track") as HTMLElement;
    const dotsContainer = document.getElementById(
      "carousel-dots",
    ) as HTMLElement;
    const prevBtn = document.getElementById("carousel-prev");
    const nextBtn = document.getElementById("carousel-next");
    const modalTitle = document.getElementById("proj-modal-title");
    const modalBadge = document.getElementById("proj-modal-badge");
    const modalYear = document.getElementById("proj-modal-year");
    const modalDesc = document.getElementById("proj-modal-desc");
    const modalTags = document.getElementById("proj-modal-tags");
    const modalLink = document.getElementById(
      "proj-modal-link",
    ) as HTMLAnchorElement;

    if (!modal) return;

    let currentSlide = 0;
    let totalSlides = 0;

    function goTo(index: number) {
      currentSlide = (index + totalSlides) % totalSlides;
      track.style.transform = `translateX(-${currentSlide * 100}%)`;
      document.querySelectorAll(".carousel-dot").forEach((d, i) => {
        d.classList.toggle("active", i === currentSlide);
      });
    }

    prevBtn?.addEventListener("click", () => goTo(currentSlide - 1));
    nextBtn?.addEventListener("click", () => goTo(currentSlide + 1));

    // Open modal
    document.querySelectorAll(".project-card").forEach((card) => {
      const open = () => {
        const raw = card.getAttribute("data-project");
        if (!raw) return;
        const data = JSON.parse(raw);

        // Carousel
        track.innerHTML = "";
        dotsContainer.innerHTML = "";
        totalSlides = data.images.length;
        currentSlide = 0;

        data.images.forEach((src: string, i: number) => {
          const img = document.createElement("img");
          img.src = src;
          img.alt = `${data.title} screenshot ${i + 1}`;
          img.loading = "lazy";
          track.appendChild(img);

          const dot = document.createElement("button");
          dot.className = `carousel-dot${i === 0 ? " active" : ""}`;
          dot.setAttribute("aria-label", `Slide ${i + 1}`);
          dot.addEventListener("click", () => goTo(i));
          dotsContainer.appendChild(dot);
        });

        track.style.transform = "translateX(0)";

        // Show/hide nav
        const showNav = totalSlides > 1;
        if (prevBtn)
          (prevBtn as HTMLElement).style.display = showNav ? "flex" : "none";
        if (nextBtn)
          (nextBtn as HTMLElement).style.display = showNav ? "flex" : "none";
        dotsContainer.style.display = showNav ? "flex" : "none";

        // Content
        if (modalTitle) modalTitle.textContent = data.title;
        if (modalBadge) modalBadge.textContent = data.type;
        if (modalYear) modalYear.textContent = data.year;
        if (modalDesc) modalDesc.textContent = data.longDescription;

        // Link
        if (modalLink) {
          if (data.link) {
            modalLink.href = data.link;
            modalLink.classList.remove("hidden");
          } else {
            modalLink.classList.add("hidden");
          }
        }

        // Tags — same chip style as project cards
        if (modalTags) {
          modalTags.innerHTML = "";
          data.tags.forEach((tag: { name: string; icon?: string }) => {
            const chip = document.createElement("span");
            chip.className = "modal-chip";
            if (tag.icon) {
              const iconBase = tag.icon.split("-")[0];
              const img = document.createElement("img");
              img.src = `https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${iconBase}/${tag.icon}.svg`;
              img.alt = tag.name;
              img.crossOrigin = "anonymous";
              img.width = 16;
              img.height = 16;
              img.onerror = () => { img.style.display = "none"; };
              chip.appendChild(img);
            }
            chip.appendChild(document.createTextNode(tag.name));
            modalTags.appendChild(chip);
          });
        }

        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      };

      card.addEventListener("click", open);
      card.addEventListener("keydown", (e) => {
        if (
          (e as KeyboardEvent).key === "Enter" ||
          (e as KeyboardEvent).key === " "
        ) {
          e.preventDefault();
          open();
        }
      });
    });

    // Close
    const closeModal = () => {
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      setTimeout(() => {
        track.innerHTML = "";
        dotsContainer.innerHTML = "";
      }, 350);
    };

    closeBtn?.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("is-open"))
        closeModal();
      if (e.key === "ArrowLeft" && modal.classList.contains("is-open"))
        goTo(currentSlide - 1);
      if (e.key === "ArrowRight" && modal.classList.contains("is-open"))
        goTo(currentSlide + 1);
    });
  });
</script>
