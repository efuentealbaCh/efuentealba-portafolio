const projects = projectsData[lang];

const typeColors: Record<string, string> = {
  "Web App": "#5A7D6B",
  Dashboard: "#4E6B7C",
  Backend: "#7C5A6B",
  Frontend: "#6B7C4E",
  Módulo: "#7C6B4E",
  Module: "#7C6B4E",
