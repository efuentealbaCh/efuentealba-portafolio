---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface TechTag {
  name: string;
  icon?: string;
}

interface Project {
  title: string;
  description: string;
  longDescription: string;
  type: string;
  year: string;
  tags: TechTag[];
  link?: string;
  images: string[];
}

